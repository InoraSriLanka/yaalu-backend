// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum Role {
  CUSTOMER
  SHOP
  RIDER
  ADMIN
}

enum RiderStatus {
  PENDING
  AVAILABLE
  BUSY
  OFFLINE
  SUSPENDED
}

// ─── Core User Model ──────────────────────────────────────

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  fullName      String?          @map("full_name")
  role          Role             @default(CUSTOMER)
  password      String?
  otp           String?
  otpExpiresAt  DateTime?        @map("otp_expires_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // 1-to-1 Relations to Role-specific Tables
  customerProfile CustomerProfile?
  shopProfile     ShopProfile?
  riderProfile    RiderProfile?

  @@map("users")
}

// ─── 1. Customer Role Table ───────────────────────────────

model CustomerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName        String?  @map("full_name")
  phone           String?
  deliveryAddress String?  @map("delivery_address")
  city            String?
  latitude        Float?
  longitude       Float?

  // Card Payment Details (last 4 digits only for security)
  cardLast4       String?  @map("card_last4")
  cardType        String?  @map("card_type")
  billingAddress  String?  @map("billing_address")
  notes           String?

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("customer_profiles")
}

// ─── 2. Shop Role Table ───────────────────────────────────

model ShopProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopName       String   @map("shop_name")
  shopAddress    String?  @map("shop_address")
  outletAddress  String?  @map("outlet_address")
  registrationNo String?  @map("registration_no")
  ownerName      String?  @map("owner_name")
  ownerEmail     String?  @map("owner_email")
  ownerPhone     String?  @map("owner_phone")
  businessType   String?  @map("business_type")
  logoUrl        String?  @map("logo_url")
  bannerUrl      String?  @map("banner_url")
  shopImage      String?  @map("shop_image")

  // Bank & Payout Details
  bankName       String?  @map("bank_name")
  accountName    String?  @map("account_name")
  accountNo      String?  @map("account_no")
  accountBranch  String?  @map("account_branch")

  // Card Payment Details (last 4 digits only for security)
  cardLast4      String?  @map("card_last4")
  cardType       String?  @map("card_type")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("shop_profiles")
}

// ─── 3. Rider Role Table ──────────────────────────────────

model RiderProfile {
  id               String      @id @default(uuid())
  userId           String      @unique @map("user_id")
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleType      String      @map("vehicle_type") // e.g., MOTORBIKE, SCOOTER, THREE_WHEEL, CAR, VAN
  vehicleNumber    String      @map("vehicle_number")
  vehicleModel     String?     @map("vehicle_model")
  licenseNumber    String      @map("license_number")
  status           RiderStatus @default(PENDING)
  currentLatitude  Float?      @map("current_latitude")
  currentLongitude Float?      @map("current_longitude")
  isApproved       Boolean     @default(false) @map("is_approved")

  // Bank Payout Details
  bankName         String?     @map("bank_name")
  accountName      String?     @map("account_name")
  accountNo        String?     @map("account_no")
  accountBranch    String?     @map("account_branch")

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@map("rider_profiles")
}

// ─── Product Service Models ──────────────────────────────

model Product {
  id          String   @id @default(uuid())
  merchantId  String   @default("default")
  name        String
  price       Decimal  @db.Decimal(10, 2)
  unit        String   @default("unit")
  stock       Int      @default(0)
  imageUrl    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

// ─── Order Service Models ──────────────────────────────

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

model Order {
  id           String      @id @default(uuid())
  merchantId   String      @default("default")
  customerId   String?
  customerName String?
  items        OrderItem[]
  totalAmount  Decimal     @default(0) @db.Decimal(10, 2)
  status       OrderStatus @default(pending)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)

  @@map("order_items")
}


enum InvoiceStatus {
  pending
  paid
}

model Invoice {
  id           String        @id @default(uuid())
  merchantId   String        @default("default")
  customerId   String?
  customerName String?
  orderId      String?
  amount       Decimal       @db.Decimal(10, 2)
  status       InvoiceStatus @default(pending)
  dueDate      DateTime?     @db.Date
  notes        String?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("invoices")
}

// ─── Cards ──────────────────────────────────────────────────

model UserCard {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  cardholderName  String   @map("cardholder_name")
  cardNumberMask  String   @map("card_number_mask")
  expiryDate      String   @map("expiry_date")
  cardType        String   @default("VISA") @map("card_type")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_cards")
}

// ─── Rides & Delivery ───────────────────────────────────────

model RideRequest {
  id                  String        @id @default(uuid())
  customerId          String        @map("customer_id")
  pickupAddress       String        @map("pickup_address")
  dropoffAddress      String        @map("dropoff_address")
  pickupLat           Float?        @map("pickup_lat")
  pickupLng           Float?        @map("pickup_lng")
  dropoffLat          Float?        @map("dropoff_lat")
  dropoffLng          Float?        @map("dropoff_lng")
  rideType            String        @default("STANDARD") @map("ride_type")
  selectedVehicleType String        @default("bike") @map("selected_vehicle_type")
  tripCategory        String        @default("ONE_WAY") @map("trip_category")
  status              String        @default("SEARCHING")
  acceptedDriverId    String?       @map("accepted_driver_id")
  biddingTimerSeconds Int           @default(480) @map("bidding_timer_seconds")
  startPin            String?       @map("start_pin")
  etaMinutes          Int?          @map("eta_minutes")
  finalFare           Float?        @map("final_fare")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  bids                DriverBid[]
  feedback            RideFeedback?

  @@map("ride_requests")
}

model DriverBid {
  id              String   @id @default(uuid())
  rideRequestId   String   @map("ride_request_id")
  rideRequest     RideRequest @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)
  driverId        String   @map("driver_id")
  driverName      String?  @map("driver_name")
  rating          Float    @default(5.0)
  vehicleModel    String?  @map("vehicle_model")
  vehicleNumber   String?  @map("vehicle_number")
  proposedFare    Float    @map("proposed_fare")
  status          String   @default("PENDING")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("driver_bids")
}

model RideFeedback {
  id              String   @id @default(uuid())
  rideRequestId   String   @unique @map("ride_request_id")
  rideRequest     RideRequest @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)
  customerId      String   @map("customer_id")
  driverId        String   @map("driver_id")
  rating          Float
  compliments     String[]
  comment         String   @default("")
  tipAmount       Float    @default(0) @map("tip_amount")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("ride_feedbacks")
}
