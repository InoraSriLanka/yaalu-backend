PORT=3000

# Auth service DB
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=yaalu_auth

# Override DB_NAME per service when running locally:
# auth-service:         DB_NAME=yaalu_auth
# product-service:      DB_NAME=yaalu_products
# order-service:        DB_NAME=yaalu_orders
# payment-service:      DB_NAME=yaalu_payments
# notification-service: DB_NAME=yaalu_notifications
# delivery-service:     DB_NAME=yaalu_orders (shares with order-service)

RABBITMQ_URL=amqp://localhost:5672
